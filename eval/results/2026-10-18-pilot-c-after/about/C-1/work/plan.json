          "slots": {
            "body": [
              {
                "use": "content/prose",
                "key": "story-text",
                "data": { "html": "<p>Twelve paddlers and climbers founded the co-op in 1987 in a rented garage. Today 9,400 members own it, and every member gets one vote at the annual meeting.</p>" }
              }
            ]
          }
        },
        {
          "use": "content/section",
          "key": "beliefs",
          "data": { "title": "What we believe" },
          "slots": {
            "body": [
              {
                "use": "content/prose",
                "key": "beliefs-list",
                "data": { "html": "<ol><li>Repair before replace. Our workshop fixed 3,100 items last year.</li><li>Pay people fairly. Every employee earns at least the regional living wage.</li><li>Leave places better. We give 2% of sales to trail and shoreline groups.</li></ol>" }
              }
            ]
          }
        },
        {
          "use": "content/section",
