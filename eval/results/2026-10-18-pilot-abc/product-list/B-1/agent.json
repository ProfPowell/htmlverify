        "command": "python3 - <<'E'\nP=[(\"Ridgeline 40 L\",189,\"4.7\",\"in stock\",\"ridgeline-40\"),(\"Day Hiker 22 L\",79,\"4.5\",\"in stock\",\"day-hiker-22\"),(\"Summit 55 L\",249,\"4.8\",\"2 left\",\"summit-55\"),(\"Commuter 18 L\",64,\"4.2\",\"in stock\",\"commuter-18\"),(\"Trailhead 30 L\",119,\"4.4\",\"out of stock\",\"trailhead-30\"),(\"Expedition 70 L\",329,\"4.9\",\"in stock\",\"expedition-70\"),(\"Kids&#x2019; Explorer 12 L\",45,\"4.6\",\"in stock\",\"explorer-12\"),(\"Ultralight 35 L\",215,\"4.3\",\"in stock\",\"ultralight-35\")]\nitems=\"\".join(f'''\n      <li>\n        <product-card>\n          <img src=\"/img/{s}.jpg\" alt=\"{n} backpack\" width=\"320\" height=\"320\" loading=\"lazy\"/>\n          <h3><a href=\"/shop/{s}\">{n}</a></h3>\n          <p>${p}</p>\n          <p>Rating: {r} out of 5</p>\n          <p>{a[0].upper()+a[1:]}</p>\n        </product-card>\n      </li>''' for n,p,r,a,s in P)\ndef fs(t,name,opts):\n    o=\"\".join(f'\\n          <label><input type=\"radio\" name=\"{name}\" value=\"{v}\"/> {v}</label>' for v in opts)\n    return f'''\n        <fieldset>\n          <legend>{t}</legend>{o}\n        </fieldset>'''\nhtml=f'''<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n  <title>Backpacks</title>\n  <link rel=\"stylesheet\" href=\"/vb/vanilla-breeze.css\"/>\n  <script src=\"/vb/vanilla-breeze.js\" defer=\"defer\"></script>\n</head>\n<body>\n  <main id=\"main\">\n    <h1>Backpacks</h1>\n    <p>8 products, sorted by popularity.</p>\n\n    <aside aria-label=\"Filters\">\n      <form action=\"\" method=\"get\">{fs(\"Capacity\",\"capacity\",[\"Under 30 L\",\"30–50 L\",\"Over 50 L\"])}{fs(\"Price\",\"price\",[\"Under $100\",\"$100–$200\",\"Over $200\"])}\n        <label><input type=\"checkbox\" name=\"in-stock\" value=\"1\"/> Only show items in stock</label>\n        <button type=\"submit\">Apply filters</button>\n      </form>\n    </aside>\n\n    <section aria-labelledby=\"products-heading\">\n      <h2 id=\"products-heading\">Products</h2>\n      <ul data-layout=\"grid\">{items}\n      </ul>\n    </section>\n\n    <nav aria-label=\"Pagination\">\n      <ul data-layout=\"cluster\">\n        <li><a href=\"?page=1\" aria-current=\"page\">1</a></li>\n        <li><a href=\"?page=2\">2</a></li>\n        <li><a href=\"?page=3\">3</a></li>\n        <li><a href=\"?page=2\" rel=\"next\">Next</a></li>\n      </ul>\n    </nav>\n  </main>\n</body>\n</html>\n'''\nopen(\"page.html\",\"w\").write(html)\nE\nnpx htmlverify check page.html"
