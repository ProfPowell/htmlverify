      "tool_input": {
        "command": "python3 - <<'E'\nP=[(\"Ridgeline 40 L\",189,\"4.7\",\"In stock\",\"ridgeline-40\",\"forest green\"),\n(\"Day Hiker 22 L\",79,\"4.5\",\"In stock\",\"day-hiker-22\",\"orange\"),\n(\"Summit 55 L\",249,\"4.8\",\"2 left\",\"summit-55\",\"red\"),\n(\"Commuter 18 L\",64,\"4.2\",\"In stock\",\"commuter-18\",\"charcoal\"),\n(\"Trailhead 30 L\",119,\"4.4\",\"Out of stock\",\"trailhead-30\",\"blue\"),\n(\"Expedition 70 L\",329,\"4.9\",\"In stock\",\"expedition-70\",\"yellow\"),\n(\"Kids' Explorer 12 L\",45,\"4.6\",\"In stock\",\"explorer-12\",\"teal\"),\n(\"Ultralight 35 L\",215,\"4.3\",\"In stock\",\"ultralight-35\",\"grey\")]\nitems=\"\".join(f'''\n      <li>\n        <product-card>\n          <img src=\"/img/{s}.jpg\" alt=\"{n}, a {c} backpack\" width=\"320\" height=\"240\" loading=\"lazy\"/>\n          <h3><a href=\"/shop/{s}\">{n}</a></h3>\n          <p>${p}</p>\n          <p>Rating: {r} out of 5</p>\n          <p>{a}</p>\n        </product-card>\n      </li>''' for n,p,r,a,s,c in P)\ndef opt(i,name,vals):\n    return \"\".join(f'''\n          <label><input type=\"radio\" name=\"{name}\" value=\"{v}\"/> {v}</label>''' for v in vals)\nhtml=f'''<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n  <title>Backpacks</title>\n  <link rel=\"stylesheet\" href=\"/vb/vanilla-breeze.css\"/>\n  <script src=\"/vb/vanilla-breeze.js\" defer=\"defer\"></script>\n</head>\n<body>\n  <header>\n    <nav aria-label=\"Main navigation\">\n      <ul>\n        <li><a href=\"#main\">Skip to content</a></li>\n      </ul>\n    </nav>\n    <h1>Backpacks</h1>\n    <p>8 products, sorted by popularity</p>\n  </header>\n\n  <main id=\"main\">\n    <section data-layout=\"sidebar\" aria-label=\"Backpack listing\">\n      <aside aria-labelledby=\"filters-heading\">\n        <h2 id=\"filters-heading\">Filters</h2>\n        <form action=\"/shop/backpacks\" method=\"get\">\n          <fieldset>\n            <legend>Capacity</legend>{opt(0,\"capacity\",[\"Under 30 L\",\"30–50 L\",\"Over 50 L\"])}\n          </fieldset>\n          <fieldset>\n            <legend>Price</legend>{opt(0,\"price\",[\"Under $100\",\"$100–$200\",\"Over $200\"])}\n          </fieldset>\n          <form-field>\n            <label><input type=\"checkbox\" name=\"in-stock\" value=\"1\"/> Only show items in stock</label>\n          </form-field>\n          <button type=\"submit\">Apply filters</button>\n        </form>\n      </aside>\n\n      <section aria-labelledby=\"products-heading\">\n        <h2 id=\"products-heading\">Products</h2>\n        <ul data-layout=\"grid\">{items}\n        </ul>\n      </section>\n    </section>\n\n    <nav aria-label=\"Pagination\">\n      <ul data-layout=\"cluster\">\n        <li aria-current=\"page\">Page 1 of 3</li>\n        <li><a href=\"?page=2\">2</a></li>\n        <li><a href=\"?page=3\">3</a></li>\n        <li><a href=\"?page=2\" rel=\"next\">Next</a></li>\n      </ul>\n    </nav>\n  </main>\n</body>\n</html>\n'''\nopen(\"page.html\",\"w\").write(html)\nE"
      }
