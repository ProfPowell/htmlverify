{
  "id": "form/checkbox-group",
  "version": "1.0.0",
  "summary": "A labeled group of checkboxes: any number of choices from a few.",
  "use": "Several options of which any may be chosen, such as interests. For exactly one choice, use form/choice-group; for a single yes or no, form/checkbox.",
  "context": "form",
  "params": {
    "legend": {
      "type": "text",
      "minLength": 1,
      "description": "The question the choices answer."
    },
    "name": {
      "type": "text",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "The field's name in the submitted form data."
    },
    "choices": {
      "type": "list",
      "minItems": 2,
      "items": {
        "value": {
          "type": "text",
          "minLength": 1
        },
        "label": {
          "type": "text",
          "minLength": 1
        },
        "checked": {
          "type": "boolean",
          "default": false,
          "description": "On the choices made already."
        }
      }
    },
    "hint": {
      "type": "inline",
      "required": false,
      "description": "Help shown with the field until it's valid."
    }
  },
  "provenance": {
    "authors": [
      "htmlverify starter registry"
    ],
    "aiAssisted": true
  }
}
